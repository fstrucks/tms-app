NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (do not prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 32 random bytes, base64. Server-only. Backup in Marc-only Drive folder.
PACKET_ENCRYPTION_KEY=
# Postmark inbound webhook basic auth (server-only)
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=
# Inbound domain shown in the app. Both in.fstrucks.com and in.pwrstrong.net are accepted; set in.pwrstrong.net
# only after its MX record and Postmark inbound domain are live. Blank = in.fstrucks.com.
NEXT_PUBLIC_INBOUND_DOMAIN=

# Packet step F: Send to broker (server only)
POSTMARK_SERVER_TOKEN=
# Sender for packet / COI / export email. pwrstrong.net must be a verified Postmark sender.
PACKET_FROM_EMAIL=noreply@pwrstrong.net
# Optional Reply-To when a company has not set its own Reply-to email (Company settings). Blank = none.
PACKET_REPLY_TO=
# Optional address copied on every packet / COI email. Blank = no automatic copy.
PACKET_CC_EMAIL=
# Recipients limited to these domains while set (default fstrucks.com). "*" = any (only after Postmark approval + Marc OK)
PACKET_SEND_ALLOWED_DOMAINS=fstrucks.com

# Shared monthly email cap across Send to broker + COI requests (Postmark plan is 100/month). Default 80.
EMAIL_MONTHLY_CAP=80
# COI request button (packet page). Off unless 1. Server route also refuses while off.
NEXT_PUBLIC_COI_REQUEST_ENABLED=0
